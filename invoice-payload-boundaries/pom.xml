<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mokapotlabs.invoiceassistant</groupId>
        <artifactId>invoice-assistant-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>invoice-payload-boundaries</artifactId>
    <dependencies>
        <dependency><groupId>org.pipelineframework</groupId><artifactId>object-ingest-connector</artifactId><version>${tpf.version}</version></dependency>
        <dependency><groupId>org.pipelineframework</groupId><artifactId>pipelineframework</artifactId><version>${tpf.version}</version></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest-jackson</artifactId></dependency>
        <dependency><groupId>org.eclipse.microprofile.openapi</groupId><artifactId>microprofile-openapi-api</artifactId><version>4.1.1</version></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path><groupId>org.pipelineframework</groupId><artifactId>pipelineframework-compiler</artifactId><version>${tpf.version}</version></path>
                        <path><groupId>org.pipelineframework</groupId><artifactId>object-ingest-connector</artifactId><version>${tpf.version}</version></path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration><compilerArgs>
                            <arg>-Apipeline.config=${project.basedir}/../config/payloads/pipeline.yaml</arg>
                            <arg>-Apipeline.generatedSourcesDir=${project.build.directory}/generated-sources/pipeline</arg>
                            <arg>-Apipeline.module=invoice-payload-boundaries</arg>
                        </compilerArgs></configuration>
                    </execution>
                    <execution>
                        <id>compile-generated-boundaries</id><phase>process-classes</phase><goals><goal>compile</goal></goals>
                        <configuration>
                            <proc>none</proc><useIncrementalCompilation>false</useIncrementalCompilation>
                            <compileSourceRoots><compileSourceRoot>${project.build.directory}/generated-sources/pipeline/pipeline-server</compileSourceRoot></compileSourceRoots>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
