<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mokapotlabs.invoiceassistant</groupId>
    <artifactId>invoice-assistant-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Invoice Assistant</name>

    <modules>
        <module>invoice-assistant-common</module>
        <module>assistant-local-runtime</module>
        <module>invoice-payload-boundaries</module>
        <module>invoice-assistant-monolith</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.39.2</quarkus.platform.version>
        <tpf.version>26.10.1-SNAPSHOT</tpf.version>
        <maven.compiler-plugin.version>3.14.0</maven.compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <spotless.version>2.44.3</spotless.version>
        <pdfbox.version>3.0.3</pdfbox.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>central-portal-snapshots</id>
            <name>Central Portal Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <palantirJavaFormat/>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>tpf-durable-dynamo</id>
            <properties>
                <pipeline.query.capture-store.provider>dynamo</pipeline.query.capture-store.provider>
                <pipeline.query.capture-store.dynamo.table>tpf_query_capture</pipeline.query.capture-store.dynamo.table>
                <pipeline.command.effect-store.provider>dynamo</pipeline.command.effect-store.provider>
                <pipeline.command.effect-store.dynamo.table>tpf_command_effect</pipeline.command.effect-store.dynamo.table>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.quarkus</groupId>
                        <artifactId>quarkus-maven-plugin</artifactId>
                        <configuration>
                            <systemProperties>
                                <pipeline.query.capture-store.provider>${pipeline.query.capture-store.provider}</pipeline.query.capture-store.provider>
                                <pipeline.query.capture-store.dynamo.table>${pipeline.query.capture-store.dynamo.table}</pipeline.query.capture-store.dynamo.table>
                                <pipeline.command.effect-store.provider>${pipeline.command.effect-store.provider}</pipeline.command.effect-store.provider>
                                <pipeline.command.effect-store.dynamo.table>${pipeline.command.effect-store.dynamo.table}</pipeline.command.effect-store.dynamo.table>
                            </systemProperties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
