<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.mokapotlabs.invoiceassistant</groupId>
        <artifactId>invoice-assistant-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>invoice-assistant-monolith</artifactId>
    <properties>
        <pipeline.config.path>${project.basedir}/../config/pipeline.yaml</pipeline.config.path>
        <pipeline.generatedSourcesArg>-Apipeline.generatedSourcesDir=${project.build.directory}/generated-sources/pipeline</pipeline.generatedSourcesArg>
        <pipeline.configArg>-Apipeline.config=${pipeline.config.path}</pipeline.configArg>
        <pipeline.moduleArg>-Apipeline.module=${project.artifactId}</pipeline.moduleArg>
        <!-- The demo replay exporter needs the build-produced orchestrator topology. -->
        <pipeline.orchestratorArg>-Apipeline.orchestrator.generate=true</pipeline.orchestratorArg>
    </properties>
    <dependencies>
        <dependency><groupId>org.pipelineframework</groupId><artifactId>decision-query-connector</artifactId><version>${tpf.version}</version></dependency>
        <dependency><groupId>org.pipelineframework</groupId><artifactId>decision-query-jev-connector</artifactId><version>${tpf.version}</version></dependency>
        <dependency><groupId>com.microsoft.azure</groupId><artifactId>msal4j</artifactId><version>1.26.0</version></dependency>
        <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna</artifactId><version>5.19.1</version></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-security</artifactId></dependency>
        <dependency>
            <groupId>com.mokapotlabs.invoiceassistant</groupId>
            <artifactId>invoice-payload-boundaries</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mokapotlabs.invoiceassistant</groupId>
            <artifactId>invoice-assistant-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mokapotlabs.invoiceassistant</groupId>
            <artifactId>assistant-local-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>object-ingest-connector</artifactId>
            <version>${tpf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>representation-provider-file</artifactId>
            <version>${tpf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>llm-query-langchain4j-connector</artifactId>
            <version>${tpf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>pipelineframework</artifactId>
            <version>${tpf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>cache-plugin</artifactId>
            <version>${tpf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pipelineframework</groupId>
            <artifactId>persistence-plugin</artifactId>
            <version>${tpf.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-hibernate-reactive-panache</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-reactive-pg-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest-qute</artifactId></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-jackson</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jdk8</artifactId></dependency>
        <dependency><groupId>org.webjars.npm</groupId><artifactId>htmx.org</artifactId><version>2.0.4</version></dependency>
        <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-junit</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
        <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <resource><directory>../config</directory><includes><include>pipeline.yaml</include><include>openrouter.yaml</include></includes><targetPath>invoice-config</targetPath></resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path><groupId>org.pipelineframework</groupId><artifactId>decision-query-connector</artifactId><version>${tpf.version}</version></path>
                        <path><groupId>org.pipelineframework</groupId><artifactId>decision-query-jev-connector</artifactId><version>${tpf.version}</version></path>
                        <path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>1.18.42</version></path>
                        <path><groupId>org.mapstruct</groupId><artifactId>mapstruct-processor</artifactId><version>1.5.5.Final</version></path>
                        <path><groupId>io.quarkus</groupId><artifactId>quarkus-extension-processor</artifactId><version>${quarkus.platform.version}</version></path>
                        <path><groupId>org.pipelineframework</groupId><artifactId>pipelineframework-compiler</artifactId><version>${tpf.version}</version></path>
                        <path><groupId>org.pipelineframework</groupId><artifactId>object-ingest-connector</artifactId><version>${tpf.version}</version></path>
                        <path><groupId>org.pipelineframework</groupId><artifactId>representation-provider-file</artifactId><version>${tpf.version}</version></path>
                        <path><groupId>org.pipelineframework</groupId><artifactId>llm-query-langchain4j-connector</artifactId><version>${tpf.version}</version></path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id><phase>compile</phase><goals><goal>compile</goal></goals>
                        <configuration><compilerArgs><arg>${pipeline.configArg}</arg><arg>${pipeline.generatedSourcesArg}</arg><arg>${pipeline.moduleArg}</arg><arg>${pipeline.orchestratorArg}</arg></compilerArgs></configuration>
                    </execution>
                    <execution>
                        <id>compile-generated-pipeline</id><phase>process-classes</phase><goals><goal>compile</goal></goals>
                        <configuration><proc>none</proc><useIncrementalCompilation>false</useIncrementalCompilation><compileSourceRoots><compileSourceRoot>${project.build.directory}/generated-sources/pipeline/orchestrator-client</compileSourceRoot></compileSourceRoots><outputDirectory>${project.build.outputDirectory}</outputDirectory></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>build</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin><groupId>com.diffplug.spotless</groupId><artifactId>spotless-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
